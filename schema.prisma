  roleId                         String?                   @map("role")
  approvedAgent                  ApprovedAgent?            @relation("User_approvedAgent", fields: [approvedAgentId], references: [id])
  approvedAgentId                String?                   @map("approvedAgent")
  onboardingStatus               UserOnboardingStatusType? @default(not_started)
  passengerProfile               Passenger?                @relation("Passenger_userAccount")
  offers                         Offer[]                   @relation("Offer_customer")
  bookings                       Booking[]                 @relation("Booking_customer")
  auditEvents                    AuditEvent[]              @relation("AuditEvent_actor")
  stationAssignments             StationAssignment[]       @relation("StationAssignment_user")
  documentVerifications          DocumentVerification[]    @relation("DocumentVerification_verifiedBy")
  submittedPaymentEvidence       ManualPaymentEvidence[]   @relation("ManualPaymentEvidence_submittedBy")
  approvedPaymentEvidence        ManualPaymentEvidence[]   @relation("ManualPaymentEvidence_approvedBy")
  onboardingSteps                OnboardingStep[]          @relation("OnboardingStep_user")

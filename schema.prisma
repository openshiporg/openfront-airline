  updatedAt                      DateTime                  @default(now()) @updatedAt
  passwordResetToken             String?
  passwordResetIssuedAt          DateTime?
  passwordResetRedeemedAt        DateTime?
  from_TravelDocument_verifiedBy TravelDocument[]          @relation("TravelDocument_verifiedBy")
  from_IdempotencyKey_actor      IdempotencyKey[]          @relation("IdempotencyKey_actor")

  @@index([carrierId])
  @@index([roleId])

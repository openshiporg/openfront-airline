# Copy to .env and supply real values. This file contains no usable credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=
APP_BASE_URL=https://airline.example
PUBLIC_APP_URL=https://airline.example
STOREFRONT_CARRIER_CODE=AV
# Temporary production bootstrap only: permits operator sign-in while direct sales stay disabled.
# Remove after onboarding, two-person payment control, and settlement import are ready.
ALLOW_INCOMPLETE_LAUNCH_SETUP=false
# Owner-approved empty-database UI setup only. Requires ALLOW_INCOMPLETE_LAUNCH_SETUP,
# refuses retained user/carrier/role data, and must be removed immediately after /dashboard/init.
ALLOW_INITIAL_OPERATOR_SETUP=false
# Dedicated HMAC key (32+ characters); rotate only through a document-token migration.
TRAVEL_DOCUMENT_TOKENIZATION_KEY=

SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=operations@airline.example
SMTP_STORE_LINK=https://airline.example

S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://objects.example
TRUSTED_PROXY_IPS=
ALERT_WEBHOOK_URL=https://alerts.example/webhook
# Exact comma-separated DNS hosts permitted for tenant-configured outbound webhooks.
OUTBOUND_WEBHOOK_HOSTS=events.carrier.example
# Optional authenticated operator AI/MCP surface; disabled by default in production.
AI_ASSISTANT_ENABLED=false
REQUIRED_WORKER_ID=airline-worker-1
BACKUP_RETENTION_DAYS=30
BACKUP_POLICY_VERIFICATION_ID=

# Local runtime seed only. Required only when creating its administrator;
# replay never updates an existing password.
ALLOW_RUNTIME_SEED=1
RUNTIME_ADMIN_PASSWORD=
